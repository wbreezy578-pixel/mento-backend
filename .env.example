# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Authentication
JWT_SECRET=
RESEND_API_KEY=
PAYMENT_WEBHOOK_AUTH_SECRET=
AUTH_EMAIL_FROM=Mento <auth@updates.yourdomain.com>
AUTH_WEB_BASE_URL=https://auth.yourdomain.com
MOBILE_APP_SCHEME=mentomobile
# Browser sign-in is intentionally disabled for the current mobile-only app.
AUTH_BROWSER_SIGN_IN_ENABLED=false

# Database
DATABASE_URL=
DIRECT_URL=
AI_GENERATION_LOCK_TTL_MS=120000
AI_GENERATION_LOCK_RENEW_MS=30000
AI_GENERATION_LOCK_RENEW_TIMEOUT_MS=5000
AI_GENERATION_OPERATION_DEADLINE_MS=240000

# AI
GEMINI_API_KEY=

# Realtime voice coordination (required for multi-replica production voice servers)
# Use your Upstash Redis TLS endpoint here.
REDIS_URL=your_upstash_redis_url_here
REDIS_CLUSTER_MODE=false
REQUIRE_REALTIME_REDIS=true
# Redis-backed coordination is preferred. Keep this false for resilient API
# availability: a bounded per-instance limiter protects traffic while Redis
# reconnects. Set true only when a full API outage is the accepted trade-off
# for strict cross-instance rate limiting.
REQUIRE_RATE_LIMIT_REDIS=false
RATE_WINDOW_SECONDS=60
RATE_LIMIT_PER_USER=30
RATE_LIMIT_PER_IP=300
MESSAGE_COOLDOWN_MS=2000
# Review production request volume and rate-limiter telemetry before changing these
# values so that any adjustments remain evidence-based and do not regress abuse protection.
# Optional abuse-only ceiling; product quotas remain database-backed.
DAILY_MESSAGES_LIMIT=-1
AI_DAILY_TOKEN_LIMIT=1000000
AI_DAILY_COST_LIMIT_USD=10
AI_GEMINI_REQUEST_COST_RESERVATION_USD=0.5
AI_GEMINI_REQUEST_TOKEN_RESERVATION=100000

# Google Play Billing (server only)
# Preferred: Google Workload Identity Federation external-account configuration.
GOOGLE_PLAY_WIF_CONFIG_JSON={"type":"external_account",...}
# Backwards-compatible fallback when WIF is not configured.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
GOOGLE_PLAY_RTDN_AUDIENCE=https://api.example.com/api/payments/mobile/google-rtdn
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=google-play-rtdn@your-project.iam.gserviceaccount.com

# Apple App Store server verification (server only)
# Comma-separated base64 DER Apple root certificates. Do not include PEM headers.
APPLE_ROOT_CERTIFICATES_BASE64=
APPLE_APP_ID=

# Simli Live Tutor (backend only - NEVER expose API_KEY to frontend)
SIMLI_API_KEY=your_simli_api_key_here
SIMLI_API_BASE_URL=https://api.simli.ai
SIMLI_AVATAR_ID=your_simli_avatar_id_here
SIMLI_FACE_ID=your_simli_avatar_id_here
SIMLI_VOICE_ID=your_simli_voice_id_here
# Live Tutor voice uses the OpenAI Realtime path.
LIVE_TUTOR_VOICE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_SPEED=0.95
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Off by default. Enabling this only admits explicitly requested isolated proof-of-concept sessions.
LIVE_TUTOR_LIVEKIT_POC_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional
NODE_ENV=development
# Production ingress that overwrites/appends trusted client metadata.
# Keep this aligned with the current deployment: Azure Container Apps uses the
# Set this to the active platform: azure-container-apps, cloud-run, vercel, or none.
TRUSTED_PROXY_PROVIDER=cloud-run
# Google Play review account access. Keep unset unless a dedicated review
# account is configured and the Play review credentials are being tested.
GOOGLE_PLAY_REVIEW_EMAIL=
GOOGLE_PLAY_REVIEW_MFA_BYPASS=false
# Optional: shorten Live Tutor only for exact test accounts during countdown testing.
# Leave both unset for normal production limits.
LIVE_TUTOR_TEST_MAX_SESSION_SECONDS=
LIVE_TUTOR_TEST_USER_EMAILS=
