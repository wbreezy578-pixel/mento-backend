generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  password               String                  @default("")
  name                   String?
  createdAt              DateTime                @default(now())
  authProvider           String                  @default("email")
  lastOAuthReauthAt      DateTime?
  emailVerified          Boolean                 @default(false)
  updatedAt              DateTime                @updatedAt
  failedLoginAttempts    Int                     @default(0)
  lastFailedLoginAt      DateTime?
  lastLoginAt            DateTime?
  lockedAt               DateTime?
  clerkUserId            String?                 @unique
  conversations          Conversation[]
  liveTutorSession       LiveTutorSession?
  liveTutorWallet        LiveTutorWallet?
  notifications          Notification[]
  notificationPreference NotificationPreference?
  passwordResetTokens    PasswordResetToken[]
  paymentLedgerEntries   PaymentLedgerEntry[]
  paymentReceipts        PaymentReceipt[]
  paymentTransactions    PaymentTransaction[]
  storePurchases         StorePurchase[]
  securityEvents         SecurityEvent[]
  sessions               Session[]
  usageLogs              UsageLog[]
  consentRecords         ConsentRecord[]
  chatAnalytics          ChatAnalyticsEvent[]
  userSetting            UserSetting?
  wallet                 UserWallet?
}

model ConsentRecord {
  id              String   @id @default(cuid())
  userId          String
  privacyVersion  String
  termsVersion    String
  aiNoticeVersion String
  source          String   @default("android")
  acceptedAt      DateTime @default(now())
  revokedAt       DateTime?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, privacyVersion, termsVersion, aiNoticeVersion])
  @@index([userId, acceptedAt])
}

model Notification {
  id         String               @id @default(cuid())
  userId     String
  title      String
  body       String
  type       String
  icon       String?
  actionUrl  String?
  isRead     Boolean              @default(false)
  metadata   Json?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  category   NotificationCategory
  externalId String?              @unique
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserWallet {
  id                    String    @id @default(cuid())
  userId                String    @unique
  subscriptionStatus    String    @default("active")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  planId                String
  paddleCustomerId      String?   @unique
  paddlePriceId         String?
  paddleSubscriptionId  String?   @unique
  subscriptionExpiresAt DateTime?
  paddleLastEventAt     DateTime?
  plan                  Plan      @relation(fields: [planId], references: [id])
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Plan {
  id               String       @id @default(cuid())
  name             String       @unique
  price            Float
  features         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  imageLimit       Int?
  messageLimit     Int?
  chatModel        String       @default("gemini-2.5-flash-lite")
  fairUseEnabled   Boolean      @default(true)
  imageDailyLimit  Int          @default(3)
  liveTutorEnabled Boolean      @default(false)
  priority         Int          @default(0)
  userWallets      UserWallet[]
}

model LiveTutorWallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  minutesBalance Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LiveTutorSession {
  id                    String        @id @default(cuid())
  userId                String        @unique
  streamId              String        @unique
  billingRequestId      String?       @unique
  status                String        @default("creating")
  createdAt             DateTime      @default(now())
  lastActivityAt        DateTime      @default(now())
  expiresAt             DateTime?
  secondsReserved       Int           @default(60)
  secondsConsumed       Int           @default(0)
  billingFinalized      Boolean       @default(false)
  terminalStatus        String?
  terminalReason        String?
  finalizedAt           DateTime?
  avatarVoiceProfile    String?
  ownerProcessId        String?
  finalizationStartedAt DateTime?
  conversationId        String?
  conversation          Conversation? @relation(fields: [conversationId], references: [id])
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, lastActivityAt])
  @@index([expiresAt])
  @@index([ownerProcessId])
  @@index([conversationId])
}

model UsageLog {
  id              String   @id @default(cuid())
  userId          String
  feature         String
  provider        String
  requestId       String?
  tokensInput     Int      @default(0)
  tokensOutput    Int      @default(0)
  secondsUsed     Int      @default(0)
  providerCostUSD Float    @default(0)
  userChargeUSD   Float    @default(0)
  profitUSD       Float    @default(0)
  createdAt       DateTime @default(now())
  metadata        Json?
  modelUsed       String?
  planName        String?
  success         Boolean  @default(true)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, requestId])
  @@index([userId, createdAt])
  @@index([feature, provider])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id                  String    @id @default(cuid())
  userId              String
  tokenHash           String    @unique
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lastUsedAt          DateTime?
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventType String
  severity  String   @default("info")
  details   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  emailEnabled        Boolean  @default(true)
  pushEnabled         Boolean  @default(true)
  marketingEnabled    Boolean  @default(false)
  weeklyDigestEnabled Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSetting {
  id          String   @id @default(cuid())
  userId      String   @unique
  theme       String   @default("system")
  language    String   @default("en")
  timezone    String   @default("UTC")
  compactMode Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentTransaction {
  id                     String                @id @default(cuid())
  userId                 String?
  provider               String
  type                   String
  status                 String
  amountUsd              Float
  amountMinor            Int
  currency               String
  description            String
  idempotencyKey         String?               @unique
  providerCustomerId     String?
  providerSubscriptionId String?
  providerTransactionId  String?               @unique
  providerPayload        Json?
  metadata               Json?
  failureReason          String?
  receiptNumber          String?
  lastWebhookAt          DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  ledgerEntries          PaymentLedgerEntry[]
  receipt                PaymentReceipt?
  webhookEvents          PaymentWebhookEvent[]
  storePurchase          StorePurchase?
  user                   User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StorePurchase {
  id                    String              @id @default(cuid())
  userId                String?
  paymentTransactionId  String?             @unique
  provider              String
  productId             String
  purchaseToken         String
  transactionId         String?
  originalTransactionId String?
  purchaseType          String
  status                String
  quantity              Int                 @default(1)
  purchasedAt           DateTime?
  expiresAt             DateTime?
  autoRenewing          Boolean?
  acknowledged          Boolean             @default(false)
  consumed              Boolean             @default(false)
  environment           String?
  rawPayload            Json?
  lastVerifiedAt        DateTime            @default(now())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  paymentTransaction    PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@unique([provider, purchaseToken])
  @@index([userId, status])
  @@index([provider, transactionId])
  @@index([provider, originalTransactionId])
}

model PaymentWebhookEvent {
  id             String              @id @default(cuid())
  provider       String
  eventId        String
  notificationId String?
  eventType      String
  occurredAt     DateTime
  rawPayload     String
  status         String              @default("RECEIVED")
  attempts       Int                 @default(0)
  error          String?
  processedAt    DateTime?
  transactionId  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  transaction    PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([status, createdAt])
  @@index([notificationId])
}

model PaymentReceipt {
  id            String             @id @default(cuid())
  transactionId String             @unique
  userId        String?
  receiptNumber String
  status        String
  receiptUrl    String?
  payload       Json?
  documentHash  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentLedgerEntry {
  id            String             @id @default(cuid())
  transactionId String
  userId        String?
  entryType     String
  amountUsd     Float
  amountMinor   Int                @default(0)
  currency      String
  balanceAfter  Float
  referenceType String
  referenceId   String
  description   String
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([transactionId, entryType])
}

model PricingConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Conversation {
  id                String                @id @default(cuid())
  userId            String
  title             String?
  pinned            Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  source            String                @default("chat")
  summary           String?
  summaryUpdatedAt  DateTime?
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          ConversationMessage[]
  liveTutorSessions LiveTutorSession[]
  analytics         ChatAnalyticsEvent[]

  @@index([userId, source, updatedAt])
}

model ChatAnalyticsEvent {
  id             String        @id @default(cuid())
  userId         String
  conversationId String?
  messageId      String?
  eventType      String
  promptHash     String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, eventType, createdAt])
  @@index([conversationId, createdAt])
  @@index([promptHash, createdAt])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  userId         String       @default("")
  role           String       @default("user")
  status         String       @default("completed")
  content        String       @default("")
  text           String?
  feedback       String?
  saved          Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
}

enum NotificationCategory {
  BILLING
  TUTOR
  SECURITY
  SUPPORT
  PRODUCT_UPDATES
}
